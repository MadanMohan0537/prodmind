{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodmind.dev/schema/opportunity.schema.json",
  "title": "Product Opportunity",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string" },
    "businessValue": { "type": "number", "minimum": 0, "maximum": 10 },
    "userValue": { "type": "number", "minimum": 0, "maximum": 10 },
    "strategicAlignment": { "type": "number", "minimum": 0, "maximum": 10 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "feasibility": { "type": "number", "minimum": 0, "maximum": 1 },
    "urgency": { "type": "number", "minimum": 0, "maximum": 10 },
    "effort": { "type": "number", "exclusiveMinimum": 0 },
    "risk": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty": { "type": "number", "minimum": 0, "maximum": 0.75 },
    "evidenceCount": { "type": "integer", "minimum": 0 },
    "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "owner": { "type": "string" }
  },
  "additionalProperties": false
}
