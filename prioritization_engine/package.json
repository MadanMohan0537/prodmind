{
  "name": "prodmind-prioritization-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "check": "node --check public/engine.js && node --check public/app.js && node --check src/worker.js && node --test test/*.test.js",
    "evaluate": "node scripts/evaluate.js evaluation/labeled-opportunities.json",
    "db:migrate:local": "wrangler d1 migrations apply prioritization-engine-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply prioritization-engine-db --remote"
  },
  "devDependencies": { "wrangler": "^4.33.1" }
}
