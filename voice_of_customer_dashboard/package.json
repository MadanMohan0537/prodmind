{
  "name": "prodmind-voice-of-customer-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "check": "node --check public/analytics.js && node --check public/app.js && node --check src/worker.js && node --test test/*.test.js",
    "evaluate": "node scripts/evaluate.js evaluation/labeled-dashboard.json",
    "db:migrate:local": "wrangler d1 migrations apply voice-of-customer-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply voice-of-customer-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.33.1"
  }
}
