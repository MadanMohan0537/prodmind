    {
      "name": "source filter",
      "records": [
        { "text": "Support record", "source": "support", "sentiment": -0.4 },
        { "text": "Survey record", "source": "survey", "sentiment": 0.4 }
      ],
      "filters": { "source": "support" },
      "expect": { "totalFeedback": 1, "topSource": "support", "needsAttention": 1 }
    }
  ]
