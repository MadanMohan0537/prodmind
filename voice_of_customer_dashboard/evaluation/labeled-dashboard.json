        { "text": "Great setup", "source": "survey", "segment": "SMB", "customerId": "b", "sentiment": 0.8, "topics": ["onboarding"] }
      ],
      "expect": { "totalFeedback": 2, "uniqueCustomers": 2, "topTopic": "onboarding", "needsAttention": 1 }
