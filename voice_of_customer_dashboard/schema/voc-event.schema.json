{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodmind.dev/schema/voc-event.schema.json",
  "title": "Voice-of-Customer Event",
  "type": "object",
  "required": ["text"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "segment": { "type": "string" },
    "customerId": { "type": "string" },
    "text": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "sentiment": { "type": ["number", "object"], "description": "A -1..1 score or an object with a score property." },
    "topics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "intents": { "type": "array" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
