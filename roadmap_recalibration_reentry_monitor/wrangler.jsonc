{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prodmind-roadmap-recalibration-reentry-monitor",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
