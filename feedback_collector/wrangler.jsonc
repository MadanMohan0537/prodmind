{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedback-collector",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{"binding":"DB","database_name":"feedback-collector-db","database_id":"REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID","migrations_dir":"migrations"}],
  "queues": {"producers":[{"binding":"INGESTION_QUEUE","queue":"feedback-ingestion"}],"consumers":[{"queue":"feedback-ingestion","max_batch_size":25,"max_batch_timeout":5,"max_retries":3}]},
  "observability": { "enabled": true }
}
