{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodmind.dev/schemas/detection-result/1.0",
  "title": "Feature request detection result",
  "type": "object",
  "required": ["schemaVersion", "model", "primaryIntent", "intents", "isFeatureRequest", "confidence", "urgency", "impact", "needsReview"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "model": { "const": "prodmind-explainable-multilabel-v1" },
    "primaryIntent": { "enum": ["feature-request", "bug-report", "complaint", "praise", "question", "churn-risk", "unclassified"] },
    "intents": { "type": "array" },
    "isFeatureRequest": { "type": "boolean" },
    "requestType": { "type": ["string", "null"], "enum": ["explicit", "implicit", null] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "urgency": { "type": "object" },
    "impact": { "type": "object" },
    "needsReview": { "type": "boolean" }
  }
}
